# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/lms_ai_tutor

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_you_generate_yourself
JWT_EXPIRES_IN=7d

# AI provider (embeddings + chat completion): "anthropic", "openai", or "gemini"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Retrieval mode: "atlas" (requires MongoDB Atlas Vector Search index named vector_index,
# definition in server/atlas/) or "local" (exact cosine similarity in app code, works with any MongoDB)
VECTOR_SEARCH_MODE=local

# RAG pipeline preset (see server/src/config/ragConfig.js). "advanced" (default) = structure-aware
# chunking + contextual headers + hybrid retrieval/rerank as validated in server/eval/RESULTS.md;
# "basic" = the original dense-only pipeline, kept as a kill switch. After changing indexing-related
# settings (or switching preset) run `npm run reindex` — retrieval warns if chunks were indexed differently.
# RAG_PIPELINE=advanced
# Optional JSON overlay for individual settings, e.g. '{"retrieval":{"topK":6}}'
# RAG_CONFIG_JSON=

# Model for short utility calls (query rewrite, reranking). A cheaper/faster model than the chat
# model is a good fit; defaults to the chat model. Note the free Gemini tier caps requests per
# model per day, and the advanced pipeline makes 1-2 extra utility calls per question.
# GEMINI_UTILITY_MODEL=gemini-3.1-flash-lite

# Retry behaviour for rate-limit/transient provider errors, and optional pacing between utility calls
# AI_MAX_RETRIES=4
# AI_MIN_INTERVAL_MS=0

# File storage (lesson attachments) — https://cloudinary.com free tier
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
